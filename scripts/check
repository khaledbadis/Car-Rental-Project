#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export LOCAL_UID="$(id -u)" LOCAL_GID="$(id -g)"
if ! docker compose exec -T db psql -U rental -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'rental_test'" | grep -q 1; then
  docker compose exec -T db createdb -U rental rental_test
fi
docker compose exec -T app php artisan test
docker compose exec -T app vendor/bin/pint --test
docker compose run --rm node npm run build
