  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Preferences": {
        "type": "object",
        "required": [
          "locale",
          "theme"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "ar",
              "en"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          }
        }
      },
      "StaffInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "role",
          "active",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 190
          },
          "role": {
            "type": "string",
            "enum": [
              "manager",
              "agent",
              "finance"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Required on creation, optional on update. Resets force a password change and revoke sessions/tokens."
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "example": {
          "name": "Demo Agent",
          "email": "new-agent@demo.test",
          "role": "agent",
          "active": true,
          "password": "TemporaryExample!2026",
          "reason": "New staff member"
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "locale": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "must_change_password": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SettingsInput": {
        "type": "object",
        "required": [
          "preparation_minutes",
          "late_grace_minutes",
          "no_show_minutes",
          "upload_limit_mb",
          "reason"
        ],
        "properties": {
          "preparation_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "late_grace_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "no_show_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "upload_limit_mb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "example": {
          "preparation_minutes": 120,
          "late_grace_minutes": 60,
          "no_show_minutes": 120,
          "upload_limit_mb": 10,
          "reason": "Initial agency settings"
        }
      },
      "PasswordInput": {
        "type": "object",
        "required": [
          "current_password",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "password_confirmation": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Present for forced-password-change response"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "message": "The given data was invalid.",
          "errors": {
            "email": [
              "The email value is invalid."
            ]
          }
        }
      },
      "Settings": {
